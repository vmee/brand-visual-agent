{
  "name": "brand-visual-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsx packages/cli/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:types": "node scripts/generate-schema-types.mjs",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@brand-visual/cli": "workspace:*",
    "@brand-visual/schemas": "workspace:*",
    "@types/node": "26.6.5",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
